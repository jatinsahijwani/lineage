    "viem": "^2.22.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@lineage/runner": "workspace:*",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
