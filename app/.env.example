# Copy this file to app/.env and fill in real values from the deployed testnet.
# Next.js only exposes vars prefixed with NEXT_PUBLIC_* to client code.

# 0G Galileo Testnet endpoints
NEXT_PUBLIC_ZERO_G_RPC_URL=https://evmrpc-testnet.0g.ai
NEXT_PUBLIC_ZERO_G_STORAGE_URL=https://indexer-storage-testnet-turbo.0g.ai
NEXT_PUBLIC_ZERO_G_DA_URL=https://da.0g.ai
NEXT_PUBLIC_ZERO_G_COMPUTE_URL=https://compute-testnet.0g.ai

# Deployed contract addresses (mirror these from the root .env / deployments.json)
NEXT_PUBLIC_LINEAGE_REGISTRY_ADDRESS=0x5Ba9010bf4A6E13F098d1ce5DBAF52c22E21B3f5
NEXT_PUBLIC_DATA_INFT_ADDRESS=0x7986F719737Cbd377Aa436092a0614bda988F18D
NEXT_PUBLIC_MODEL_INFT_ADDRESS=0xb54bcd09aAEfF92369D3f722dC8CBfdD6f861892
NEXT_PUBLIC_SKILL_INFT_ADDRESS=0x90135721Bd43e07955CA1AA5DeD4516CDAf46bcB
NEXT_PUBLIC_ROYALTY_SPLITTER_ADDRESS=0x4F27E90880E6b28525d7f7Eb8785273F11b0D0DE
NEXT_PUBLIC_ATTRIBUTION_VERIFIER_ADDRESS=0x74A7D64b84F3D36494f0Abf7641Dd79E9dfb986E

# WalletConnect cloud project id (optional — leave blank for dev)
NEXT_PUBLIC_WALLET_CONNECT_ID=

# Mainnet (fill after running deploy-mainnet.ts)
NEXT_PUBLIC_ZERO_G_RPC_URL=https://evmrpc-mainnet.0g.ai
NEXT_PUBLIC_ZERO_G_COMPUTE_URL=https://compute-mainnet.0g.ai
