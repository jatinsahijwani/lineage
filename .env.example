# 0G Testnet Endpoints (Galileo, chainId 16602)
ZERO_G_RPC_URL=https://evmrpc-testnet.0g.ai
# Storage indexer — "turbo" tier (faster). Standard alternative: indexer-storage-testnet-standard.0g.ai
ZERO_G_STORAGE_URL=https://indexer-storage-testnet-turbo.0g.ai
# DA: 0G Data Availability does NOT expose a public HTTP disperser. Real submission requires
# the gRPC client (Go-only as of 2026-05). Left here for future smoke probes; treat as TBD.
ZERO_G_DA_URL=https://da.0g.ai
# Compute: the 0G serving broker auto-resolves contracts from chainId — endpoint not used by SDK.
ZERO_G_COMPUTE_URL=https://compute-testnet.0g.ai

# Wallet (settlement operator EOA)
# Required for: deploy:testnet, seed:testnet, e2e, and the storage-write probes in `pnpm smoke`.
# Read-only probes in smoke (chain.getChainId, chain.getBlockNumber, compute.listServices) work without it.
PRIVATE_KEY=0x...

# Contract addresses (populated after deploy:testnet)
LINEAGE_REGISTRY_ADDRESS=
DATA_INFT_ADDRESS=
MODEL_INFT_ADDRESS=
SKILL_INFT_ADDRESS=
ROYALTY_SPLITTER_ADDRESS=
ATTRIBUTION_VERIFIER_ADDRESS=

# Settlement
SETTLEMENT_WINDOW_SECONDS=3600
PAYMENT_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# TEE (mock for local dev, real for testnet)
TEE_PUBLIC_KEY=0x...
MOCK_TEE=true
